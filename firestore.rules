rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBot() {
      return request.auth != null && request.auth.token.email == 'stock-bot@example.com';
    }
    // 自己的買賣紀錄與設定：只有本人能讀寫
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 新聞排隊：App 放進來，機器人讀取後刪除
    match /queue/{id} {
      allow create, update: if request.auth != null;
      allow read, delete: if isBot();
    }
    // 自動抓到的新聞：登入就能看，只有機器人能寫
    match /auto/{id} {
      allow read: if request.auth != null;
      allow write: if isBot();
    }
  }
}
